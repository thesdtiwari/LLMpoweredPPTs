# Server-only. Never prefix with NEXT_PUBLIC_ — it must not reach the browser.
# Create one at https://aistudio.google.com/api-keys
GEMINI_API_KEY=
# Optional; defaults to gemini-3.1-flash-lite (fastest and least congested on the free tier)
GEMINI_MODEL=
# Optional; comma-separated models tried when the primary is overloaded or out of quota
GEMINI_FALLBACK_MODELS=
